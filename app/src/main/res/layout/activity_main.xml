<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hc_black"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Status strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/btn_menu"
                android:layout_width="34dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                android:scaleType="center"
                android:src="@drawable/hc_ic_menu" />

            <TextView
                android:id="@+id/txt_format"
                style="@style/HC.Strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/hc_box"
                android:letterSpacing="0.1"
                android:paddingHorizontal="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="3dp"
                android:text="JPG"
                android:textColor="@color/hc_white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txt_lut"
                style="@style/HC.Strip"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:paddingHorizontal="6dp"
                android:text="LUT" />

            <TextView
                android:id="@+id/txt_timer"
                style="@style/HC.Strip"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:drawablePadding="5dp"
                android:paddingHorizontal="6dp"
                app:drawableStartCompat="@drawable/hc_ic_timer" />

            <TextView
                android:id="@+id/txt_flash"
                style="@style/HC.Strip"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:drawablePadding="5dp"
                android:paddingHorizontal="6dp"
                app:drawableStartCompat="@drawable/hc_ic_flash" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txt_count"
                style="@style/HC.Strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="@font/barlow_regular"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="0.02"
                android:textColor="@color/hc_white"
                tools:text="1 284" />

            <com.ghostyapps.heycam.ui.BatteryView
                android:id="@+id/battery"
                android:layout_width="25dp"
                android:layout_height="11dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp" />
        </LinearLayout>

        <!-- Viewfinder -->
        <com.ghostyapps.heycam.ui.ViewfinderFrame
            android:id="@+id/viewfinder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="#FF0B0B0B">

            <TextureView
                android:id="@+id/texture"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Debug builds only: a still image instead of the live feed, for store/README screenshots. -->
            <ImageView
                android:id="@+id/demo_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/frame_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:visibility="gone" />

            <com.ghostyapps.heycam.ui.ViewfinderOverlay
                android:id="@+id/overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.ghostyapps.heycam.ui.HistogramView
                android:id="@+id/histogram"
                android:layout_width="76dp"
                android:layout_height="36dp"
                android:layout_marginStart="28dp"
                android:layout_marginTop="28dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Appears while a QR code with a link is in view; tap opens the link. -->
                <TextView
                    android:id="@+id/qr_chip"
                    style="@style/HC.Caps"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/hc_toast"
                    android:clickable="true"
                    android:contentDescription="Open QR link"
                    android:drawablePadding="7dp"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:maxWidth="240dp"
                    android:paddingHorizontal="11dp"
                    android:textColor="@color/hc_white"
                    android:textSize="11sp"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/hc_ic_link" />

                <LinearLayout
                    android:id="@+id/lens_picker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="18dp"
                android:background="@drawable/hc_toast"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:visibility="gone">
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/hc_dot_red" />
                <TextView
                    android:id="@+id/toast_text"
                    style="@style/HC.Caps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:textColor="@color/hc_white"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.ghostyapps.heycam.ui.CountdownView
                android:id="@+id/countdown"
                android:layout_width="152dp"
                android:layout_height="152dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <View
                android:id="@+id/curtain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/hc_black"
                android:visibility="gone" />
        </com.ghostyapps.heycam.ui.ViewfinderFrame>

        <!-- Exposure readout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">
            <FrameLayout android:id="@+id/cell_s" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" />
            <FrameLayout android:id="@+id/cell_iso" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/cell_ev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.85" />
            <FrameLayout android:id="@+id/cell_focus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/hc_line" />

        <com.ghostyapps.heycam.ui.DialView
            android:id="@+id/dial"
            android:layout_width="match_parent"
            android:layout_height="58dp" />

        <!-- Shutter row -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="100dp"
            android:paddingHorizontal="34dp">

            <ImageView
                android:id="@+id/thumb"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center_vertical|start"
                android:background="@drawable/hc_box"
                android:contentDescription="Last photo"
                android:padding="1dp"
                android:scaleType="centerCrop" />

            <ImageButton
                android:id="@+id/shutter"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_gravity="center"
                android:background="@drawable/hc_shutter"
                android:contentDescription="Shutter"
                android:hapticFeedbackEnabled="true" />

            <TextView
                android:id="@+id/mode"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center_vertical|end"
                android:background="@drawable/hc_box"
                android:fontFamily="@font/barlow_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="A"
                android:textColor="@color/hc_white"
                android:textSize="22sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Main menu -->
    <LinearLayout
        android:id="@+id/menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hc_black"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="24dp">
            <TextView
                style="@style/HC.Caps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Main menu" />
            <ImageView
                android:id="@+id/menu_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="-13dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:scaleType="center"
                android:src="@drawable/hc_ic_close" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/menu_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/hc_line" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="24dp">
            <TextView
                android:id="@+id/menu_version"
                style="@style/HC.Caps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textColor="@color/hc_grey_dim" />
            <TextView
                android:id="@+id/menu_camera"
                style="@style/HC.Caps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:textColor="@color/hc_grey_dim" />
        </FrameLayout>
    </LinearLayout>

    <!-- Interval timer sheet -->
    <FrameLayout
        android:id="@+id/sheet_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/hc_black"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hc_line_strong" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingHorizontal="24dp">
                <TextView
                    style="@style/HC.Caps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="Interval timer" />
                <ImageView
                    android:id="@+id/sheet_close"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="-13dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close"
                    android:scaleType="center"
                    android:src="@drawable/hc_ic_close" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">
                    <com.ghostyapps.heycam.ui.WheelPicker
                        android:id="@+id/pick_seconds"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/HC.Caps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Seconds" />
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="12dp"
                    android:background="@color/hc_line" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">
                    <com.ghostyapps.heycam.ui.WheelPicker
                        android:id="@+id/pick_shots"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/HC.Caps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Shots" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:background="@color/hc_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">
                <TextView android:id="@+id/opt_sound" style="@style/HC.Strip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <TextView android:id="@+id/opt_glyph" style="@style/HC.Strip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <TextView android:id="@+id/opt_total" style="@style/HC.Strip" android:layout_width="wrap_content" android:layout_height="match_parent" android:background="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="28dp"
                android:background="@drawable/hc_box_white"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">
                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/hc_dot_red" />
                <TextView
                    android:id="@+id/btn_start_text"
                    style="@style/HC.Caps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.24"
                    android:text="Start"
                    android:textColor="@color/hc_white"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
